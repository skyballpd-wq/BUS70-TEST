<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mascot_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/transparent" android:contentDescription="@string/mascot_open">
    <ViewFlipper android:id="@+id/mascot_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
        android:autoStart="true" android:flipInterval="120" android:animateFirstView="false"
        android:importantForAccessibility="noHideDescendants">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/mascot_0" android:scaleType="fitCenter" android:contentDescription="@null" />
    </ViewFlipper>
</FrameLayout>
